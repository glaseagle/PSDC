        "#version 300 es\nprecision highp float;\n\nuniform sampler2D u_image0;\nuniform vec2 u_resolution;\n\nin vec2 v_texCoord;\nlayout(location = 0) out vec4 fragColor0;\nlayout(location = 1) out vec4 fragColor1;\nlayout(location = 2) out vec4 fragColor2;\nlayout(location = 3) out vec4 fragColor3;\n\nvoid main() {\n    vec4 color = texture(u_image0, v_texCoord);\n    vec2 center = v_texCoord - vec2(0.5);\n    float vignette = smoothstep(0.85, 0.15, length(center));\n    vec3 graded = vec3(color.r * 0.55 + 0.25, color.g * 0.85, min(color.b + 0.22, 1.0));\n    fragColor0 = vec4(mix(color.rgb, graded, vignette), color.a);\n    fragColor1 = color;\n    fragColor2 = color;\n    fragColor3 = color;\n}\n",
